#----------------------------------------------------------------------------
# environment.config — generated by ansible. WHERE the tracker runs.
# Fleet identity lives in site.config (club-owned, copied verbatim).
# Unset keys fall back to application defaults shipped in the image.
#----------------------------------------------------------------------------
[webapp]
host = 0.0.0.0
port = 5103
# External node-detail link in each map popup ("View on Meshtastic Map").
# {node_id} is replaced with the node's decimal number. Uncomment to override
# the app default (meshview.bayme.sh).
#node_map_url_template = https://meshview.bayme.sh/node/{node_id}

# [mqtt] is unset here — broker/root_topic/channel_name all fall back to
# application defaults. channel_name accepts a comma-separated list (e.g.
# "MediumFast, LongFast") if this fleet's nodes use more than one
# modem-preset channel.

[alerts]
email_from = {{ buoy_role_project | default('buoy-tracker') }}@{{ host_domain }}
smtp_host = {{ buoy_smtp_host }}
smtp_port = {{ buoy_smtp_port }}
smtp_ssl = false
tracker_url = https://{{ buoy_role_app_fqdn }}

[debug]
log_level = ERROR

[security]
environment = production
